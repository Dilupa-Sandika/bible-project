---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import kjvBible from '../../../data/en_kjv.json';

export async function getStaticPaths() {
  const paths = [];
  kjvBible.forEach(book => {
    book.chapters.forEach((_, index) => {
      paths.push({
        params: { book: book.abbrev, chapter: (index + 1).toString() },
        props: { book, chapter: index + 1 }
      });
    });
  });
  return paths;
}

const { book, chapter } = Astro.props;
const chapterData = book.chapters[chapter - 1];

// --- LOCAL AUDIO LOGIC (Updated for kjv_ot / kjv_nt folders) ---

// 1. පොතේ අංකය (01, 02...)
const bookIndex = kjvBible.findIndex(b => b.abbrev === book.abbrev);
const bookNumPad = (bookIndex + 1).toString().padStart(2, '0');

// 2. පොතේ නම (Spaces වෙනුවට Underscore දානවා. උදා: "1 Kings" -> "1_Kings")
const bookNameClean = book.name.replace(/\s+/g, '_');

// 3. පරිච්ඡේද අංකය (01, 02...)
const chapterPad = chapter.toString().padStart(2, '0');

// 4. Folder Name (පළමු පොත් 39 පරණ ගිවිසුම - kjv_ot)
// මෙතන තමයි අපි වෙනස් කළේ.
const folderName = bookIndex < 39 ? "kjv_ot" : "kjv_nt";

// 5. ෆයිල් නම හදනවා (Format: 01_Genesis_01.mp3)
const fileName = `${bookNumPad}_${bookNameClean}_${chapterPad}.mp3`;

// 6. Final Link (උදා: /audio/kjv_ot/01_Genesis_01.mp3)
const audioSrc = `/audio/${folderName}/${fileName}`;

// Navigation Logic
const totalChapters = book.chapters.length;
const prevChapter = chapter > 1 ? chapter - 1 : null;
const nextChapter = chapter < totalChapters ? chapter + 1 : null;
---

<BaseLayout title={`${book.name} ${chapter} - KJV Bible`}>

    <div class="mb-6 text-sm text-gray-600 dark:text-gray-400 flex items-center gap-2">
        <a href="/" class="hover:text-blue-600 hover:underline font-medium">Bible</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        <span class="font-bold text-gray-800 dark:text-gray-200">{book.name}</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        <span class="text-blue-600 dark:text-blue-400 font-semibold">Chapter {chapter}</span>
    </div>

    <div class="max-w-4xl mx-auto bg-white dark:bg-gray-800 p-6 md:p-10 rounded-3xl shadow-xl border border-gray-100 dark:border-gray-700">
        
        <div class="text-center mb-10">
            <h1 class="text-4xl md:text-5xl font-extrabold text-gray-900 dark:text-white mb-2 tracking-tight">
                {book.name} <span class="text-blue-600">{chapter}</span>
            </h1>
            <div class="h-1 w-20 bg-blue-600 mx-auto rounded-full mb-4"></div>
            <p class="text-gray-500 dark:text-gray-400 uppercase tracking-widest text-xs font-bold">
                King James Version
            </p>
        </div>

        <div class="mb-10 p-1 bg-gradient-to-r from-blue-500 to-blue-600 rounded-2xl shadow-md">
            <div class="bg-white dark:bg-gray-900 rounded-xl p-4 flex flex-col md:flex-row items-center gap-4">
                <div class="flex items-center gap-3 text-blue-700 dark:text-blue-400 font-bold text-sm whitespace-nowrap">
                    <div class="p-2 bg-blue-100 dark:bg-blue-900/30 rounded-full">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" /></svg>
                    </div>
                    Listen Now
                </div>
                <audio controls class="w-full focus:outline-none" preload="none">
                    <source src={audioSrc} type="audio/mpeg">
                    Your browser does not support the audio element.
                </audio>
            </div>
        </div>

        <div class="space-y-2">
            {chapterData.map((text, index) => (
                <div class="flex gap-4 p-3 rounded-xl hover:bg-blue-50 dark:hover:bg-gray-700/50 transition-colors group">
                    <span class="text-xs font-bold text-blue-400/80 group-hover:text-blue-600 pt-1.5 w-6 shrink-0 select-none text-right font-mono">
                        {index + 1}
                    </span>
                    <p class="text-gray-700 dark:text-gray-300 leading-relaxed text-lg">
                        {text}
                    </p>
                </div>
            ))}
        </div>

        <div class="flex justify-between items-center mt-16 pt-8 border-t border-gray-100 dark:border-gray-700">
            {prevChapter ? (
                <a href={`/en/${book.abbrev}/${prevChapter}/`} class="group flex items-center gap-2 px-6 py-3 rounded-xl bg-gray-50 dark:bg-gray-700 text-gray-600 dark:text-gray-300 hover:bg-blue-600 hover:text-white transition-all font-bold border border-gray-200 dark:border-gray-600 hover:border-blue-600">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform group-hover:-translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
                    Previous
                </a>
            ) : (
                <div></div>
            )}

            {nextChapter ? (
                <a href={`/en/${book.abbrev}/${nextChapter}/`} class="group flex items-center gap-2 px-6 py-3 rounded-xl bg-blue-600 text-white hover:bg-blue-700 transition-all font-bold shadow-lg hover:shadow-blue-500/30">
                    Next Chapter
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                </a>
            ) : (
                <div></div>
            )}
        </div>

    </div>
</BaseLayout>